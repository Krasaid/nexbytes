{
  "name": "nexbytes",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run tests/unit",
    "test:rules": "node scripts/test-rules.mjs",
    "emulators": "firebase emulators:start --only firestore",
    "deploy": "npm test && npm run build && firebase deploy --only hosting",
