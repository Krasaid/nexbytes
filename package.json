    "deploy:rules": "firebase deploy --only firestore:rules"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vue": "^7.1.2",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "astro": "^7.4.4",
    "firebase": "^13.1.0",
    "gsap": "^3.15.0",
    "typescript": "^6.0.3",
    "vue": "^3.5.44",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "vitest": "^5.0.5"
  }
}
