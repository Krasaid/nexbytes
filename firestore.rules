rules_version = '2';

// Reglas de la landing y el CMS de Nexbytes.
// - El público solo puede CREAR en `cotizaciones` y `lista_espera`, con campos y largos validados.
// - En esas dos colecciones el admin puede leer y cambiar solo `estado` y `notas`.
// - El contenido (`borradores`, `publicado`) y `publicaciones` son solo del admin. El build y
//   GitHub Actions usan firebase-admin, que se salta estas reglas.
// - Nadie puede borrar desde el cliente.
// Los largos máximos son los de src/lib/limites.ts: si cambias uno, cámbialo en ambos lados.
// Los nombres de bloque son los de src/lib/bloques.ts.
// Pruebas: npm run test:rules (emulador).

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.uid == 'kcUUn8dbtDdrv50iXDHkcupN8t73';
    }

    function texto(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    // Una función del cotizador: string de 1 a 120 caracteres (o posición vacía).
    function funcionOk(l, i) {
      return l.size() <= i || texto(l[i], 1, 120);
    }

    // Las reglas no tienen bucles: se revisa cada posición hasta el máximo (12).
    function funcionesOk(l) {
      return l is list && l.size() <= 12
        && funcionOk(l, 0) && funcionOk(l, 1) && funcionOk(l, 2) && funcionOk(l, 3)
        && funcionOk(l, 4) && funcionOk(l, 5) && funcionOk(l, 6) && funcionOk(l, 7)
        && funcionOk(l, 8) && funcionOk(l, 9) && funcionOk(l, 10) && funcionOk(l, 11);
    }

    // El admin solo puede tocar `estado` (con un valor conocido) y `notas`.
    function soloCambiaEstadoYNotas(estados) {
      let d = request.resource.data;
      return d.diff(resource.data).affectedKeys().hasOnly(['estado', 'notas'])
        && d.estado in estados
        && (!('notas' in d) || texto(d.notas, 0, 2000));
    }

    match /cotizaciones/{id} {
      function cotizacionValida(d) {
        return d.keys().hasOnly([
            'ref', 'tipo', 'funciones', 'plazo', 'presupuesto',
            'nombre', 'empresa', 'correo', 'whatsapp', 'descripcion',
            'estado', 'canal', 'creadoEn'
          ])
          && d.keys().hasAll([
            'ref', 'tipo', 'funciones', 'plazo', 'presupuesto',
            'nombre', 'empresa', 'correo', 'whatsapp', 'descripcion',
            'estado', 'canal', 'creadoEn'
          ])
          && d.ref is string && d.ref.matches('^NX-[A-Z0-9]{4}$')
          && texto(d.tipo, 1, 120)
          && funcionesOk(d.funciones)
          && texto(d.plazo, 1, 120)
          && texto(d.presupuesto, 1, 120)
          && texto(d.nombre, 1, 100)
          && texto(d.empresa, 0, 120)
          && texto(d.correo, 0, 254)
          && texto(d.whatsapp, 0, 30)
          && (d.correo.size() > 0 || d.whatsapp.size() > 0)
          && texto(d.descripcion, 0, 2000)
          && d.estado == 'nuevo'
          && d.canal == 'whatsapp'
          && d.creadoEn == request.time;
      }

      allow create: if cotizacionValida(request.resource.data);
      allow read: if isAdmin();
      allow update: if isAdmin()
        && soloCambiaEstadoYNotas(['nuevo', 'contactado', 'propuesta', 'ganado', 'perdido']);
      allow delete: if false;
    }

    match /lista_espera/{id} {
      function registroValido(d) {
        return d.keys().hasOnly(['email', 'estado', 'creadoEn'])
          && d.keys().hasAll(['email', 'estado', 'creadoEn'])
          && texto(d.email, 6, 254)
          && d.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$')
          && d.estado == 'nuevo'
          && d.creadoEn == request.time;
      }

      allow create: if registroValido(request.resource.data);
      allow read: if isAdmin();
      allow update: if isAdmin() && soloCambiaEstadoYNotas(['nuevo', 'invitado', 'baja']);
      allow delete: if false;
    }

    // ── Contenido del CMS ──────────────────────────────────────────────

    function esBloque(b) {
      return b in ['site', 'hero', 'servicios', 'proyectos', 'proceso', 'producto', 'cotizador', 'nosotros'];
    }

    // Cada guardado lleva `version` entera y `actualizadoEn` con la hora del servidor.
    function metaOk(d) {
      return d.version is int && d.actualizadoEn == request.time;
    }

    match /borradores/{bloque} {
      allow read: if isAdmin();
      allow create: if isAdmin() && esBloque(bloque)
        && metaOk(request.resource.data)
        && request.resource.data.version == 1;
      // `version` sube de uno en uno: un guardado hecho sobre una copia vieja se rechaza.
      allow update: if isAdmin()
        && metaOk(request.resource.data)
        && request.resource.data.version == resource.data.version + 1;
      allow delete: if false;
    }

    match /publicado/{bloque} {
      // Publicar es copiar el borrador tal cual, con su misma `version`: así el admin
      // sabe qué bloques tienen cambios sin publicar (version del borrador > publicado).
      // Solo cambia `actualizadoEn`.
      function copiaDelBorrador() {
        let ruta = /databases/$(database)/documents/borradores/$(bloque);
        return exists(ruta)
          && request.resource.data.diff(get(ruta).data).affectedKeys().hasOnly(['actualizadoEn']);
      }

      allow read: if isAdmin();
      allow create, update: if isAdmin() && esBloque(bloque)
        && metaOk(request.resource.data)
        && copiaDelBorrador();
      allow delete: if false;
    }

    // Historial de publicaciones. El admin las solicita; GitHub Actions (firebase-admin)
    // cambia `estado` y agrega `terminadaEn`, `url` o `error`. El admin solo puede marcar
    // como error una solicitud que no llegó a GitHub (por ejemplo, /publish respondió 503).
    match /publicaciones/{id} {
      function solicitudValida(d) {
        return d.keys().hasOnly(['estado', 'tipo', 'solicitadaEn'])
          && d.keys().hasAll(['estado', 'tipo', 'solicitadaEn'])
          && d.estado == 'solicitada'
          && d.tipo in ['produccion', 'preview']
          && d.solicitadaEn == request.time;
      }

      function marcaComoError(d) {
        return resource.data.estado == 'solicitada'
          && d.diff(resource.data).affectedKeys().hasOnly(['estado', 'error', 'terminadaEn'])
          && d.estado == 'error'
          && texto(d.error, 1, 300)
          && d.terminadaEn == request.time;
      }

      allow read: if isAdmin();
      allow create: if isAdmin() && solicitudValida(request.resource.data);
      allow update: if isAdmin() && marcaComoError(request.resource.data);
      allow delete: if false;
    }

    // Todo lo demás está cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
