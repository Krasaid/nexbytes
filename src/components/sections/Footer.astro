---
import type { Site } from '../../lib/schemas';
import { mailtoUrl, whatsappUrl } from '../../lib/links';
import Logo from '../ui/Logo.astro';

interface Props {
  site: Site;
}

const { site } = Astro.props;
const { footer } = site;

const contacto = [
  { texto: site.correo, href: mailtoUrl(site.correo) },
  { texto: site.whatsapp, href: whatsappUrl(site.whatsapp) },
  { texto: site.ciudad, href: undefined },
];

const year = new Date().getFullYear();
---

<footer id="contacto" class="footer">
  <div class="line" data-anim="draw-line" aria-hidden="true"></div>

  <div class="container inner">
    <div class="top">
      <div class="about">
        <div class="brand">
          <Logo size={32} />
          <span>{site.nombre}</span>
        </div>
        <p>{site.tagline}</p>
      </div>

      <div class="columns">
        <div class="column">
          <h2>{footer.tituloContacto}</h2>
          <ul role="list">
            {
              contacto.map(({ texto, href }) => (
                <li>{href ? <a href={href}>{texto}</a> : <span>{texto}</span>}</li>
              ))
            }
          </ul>
        </div>

        <nav class="column" aria-labelledby="footer-explorar">
          <h2 id="footer-explorar">{footer.tituloExplorar}</h2>
          <ul role="list">
            {footer.explorar.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
          </ul>
        </nav>
      </div>
    </div>

    <div class="bottom">
      <span>© {year} {footer.derechos}</span>
      <span class="code">{footer.codigo}</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
  }

  .line {
    height: 1px;
    background: var(--gold);
    transform-origin: left center;
  }

  .inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
    padding-block: var(--space-14) var(--space-10);
  }

  .top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-8);
  }

  .about {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 360px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-lg);
    font-weight: 700;
    letter-spacing: var(--tracking-brand);
    text-transform: uppercase;
  }

  .about p {
    font-size: var(--text-md);
    color: var(--muted);
  }

  .columns {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-12);
  }

  .column {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: var(--text-md);
  }

  h2 {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 400;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--faint);
  }

  ul {
    display: flex;
    flex-direction: column;
  }

  li > a,
  li > span {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    color: var(--text-soft);
  }

  li > a:hover {
    color: var(--gold-light);
  }

  .bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
    padding-top: var(--space-6);
    border-top: 1px solid var(--line);
    font-size: var(--text-sm);
    color: var(--faint);
  }

  .code {
    font-family: var(--font-mono);
  }
</style>
