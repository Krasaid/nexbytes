---
import type { Hero } from '../../lib/schemas';
import Button from '../ui/Button.astro';
import Logo from '../ui/Logo.astro';

interface Props {
  hero: Hero;
}

const { hero } = Astro.props;
const { tarjeta } = hero;
---

<!--
  data-anim-scope="hero": estos elementos los anima la línea de tiempo de entrada
  (no ScrollTrigger). data-anim-delay es la posición en segundos dentro de esa línea.
-->
<section id="inicio" class="hero container" aria-labelledby="hero-titulo" data-anim-scope="hero">
  <div class="copy">
    <span class="eyebrow" data-anim="fade-up" data-anim-delay="0">{hero.eyebrow}</span>
    <h1 id="hero-titulo" data-anim="split-words" data-anim-delay="0.1">{hero.titulo}</h1>
    <p class="subtitulo" data-anim="fade-up" data-anim-delay="0.45">{hero.subtitulo}</p>
    <div class="ctas" data-anim="fade-up" data-anim-delay="0.6">
      <Button href={hero.ctaPrimario.href} size="lg">{hero.ctaPrimario.label}</Button>
      <Button href={hero.ctaSecundario.href} size="lg" variant="ghost">{hero.ctaSecundario.label}</Button>
    </div>
  </div>

  <div class="visual">
    <div class="card" data-anim="draw-border" data-anim-delay="0.25">
      <svg class="outline" data-anim-part="outline" aria-hidden="true" focusable="false">
        <!-- rx = --radius-lg (14px) menos medio trazo. El tamaño lo pone animations.ts. -->
        <rect
          x="0.5"
          y="0.5"
          rx="13.5"
          ry="13.5"
          pathLength="1"
          stroke-dasharray="1"
          stroke-dashoffset="1"
        ></rect>
      </svg>
      <span class="corner corner-tl" data-anim-part="corner" aria-hidden="true"></span>
      <span class="corner corner-br" data-anim-part="corner" aria-hidden="true"></span>

      <div class="card-brand" data-anim-part="content">
        <Logo size={52} />
        <div class="card-names">
          <span class="card-marca">{tarjeta.marca}</span>
          <span class="card-subtitulo">{tarjeta.subtitulo}</span>
        </div>
      </div>

      <div class="card-meta" data-anim-part="content">
        <span>{tarjeta.codigo}</span>
        <span>{tarjeta.ubicacion}</span>
      </div>
    </div>

    <ul role="list" class="chips">
      {
        hero.chips.map((chip, i) => (
          <li data-anim="fade-up" data-anim-delay={String(1.1 + i * 0.1)}>
            <span class="chip-numero">{chip.numero}</span>
            <span>{chip.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .hero {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-16);
    padding-block: var(--section-pad) calc(var(--section-pad) + var(--space-2));
  }

  /* ── Texto ── */
  .copy {
    flex: 999 1 520px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-7);
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--gold);
  }

  h1 {
    font-size: var(--text-h1);
    line-height: 1.04;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  .subtitulo {
    max-width: 560px;
    font-size: var(--text-xl);
    line-height: 1.6;
    color: var(--muted);
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    padding-top: var(--space-2);
  }

  /* ── Tarjeta de presentación ── */
  .visual {
    flex: 1 1 380px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .card {
    position: relative;
    aspect-ratio: 1.75;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(var(--space-5), 5vw, var(--space-8));
    background: var(--bg-alt);
    border: 1px solid var(--gold);
    border-radius: var(--radius-lg);
  }

  /* Borde que se "dibuja" en la entrada. Invisible por defecto: sin JS manda el borde CSS. */
  .outline {
    position: absolute;
    top: -1px;
    left: -1px;
    width: calc(100% + 2px);
    height: calc(100% + 2px);
    overflow: visible;
    pointer-events: none;
    opacity: 0;
  }

  /* stroke-dasharray/offset van como atributos en el <rect>: si estuvieran aquí,
     el CSS taparía el atributo que anima animations.ts. */
  .outline rect {
    fill: none;
    stroke: var(--gold);
    stroke-width: 1;
  }

  .corner {
    position: absolute;
    width: 18px;
    height: 18px;
    border-color: var(--gold);
    border-style: solid;
    border-width: 0;
  }

  .corner-tl {
    top: 10px;
    left: 10px;
    border-top-width: 1px;
    border-left-width: 1px;
    transform-origin: top left;
  }

  .corner-br {
    right: 10px;
    bottom: 10px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    transform-origin: bottom right;
  }

  .card-brand {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .card-names {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-width: 0;
  }

  .card-marca {
    font-size: clamp(var(--text-2xl), 5vw, var(--text-4xl));
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: 0.2em;
    color: var(--gold);
  }

  .card-subtitulo {
    font-size: var(--text-sm);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .card-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--muted);
  }

  /* ── Chips ── */
  .chips {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }

  .chips li {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: 14px;
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    font-size: var(--text-md);
  }

  .chip-numero {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--gold);
  }
</style>
