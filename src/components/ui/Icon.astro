---
/**
 * Íconos de trazo por nombre. Heredan el color con `currentColor`.
 * Son decorativos por defecto (aria-hidden); si se pasa `label`, se anuncian.
 * Los trazos están en src/lib/iconos.ts (los comparte el admin).
 */
import { ICONOS } from '../../lib/iconos';
import type { IconName } from '../../lib/schemas';
export type { IconName };

interface Props {
  name: IconName;
  size?: number;
  strokeWidth?: number;
  label?: string;
  class?: string;
}

const { name, size = 24, strokeWidth = 1.6, label, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={ICONOS[name]}
/>
