---
/**
 * Logo provisional: hexágono con la "N" del mockup.
 * Para usar el logo real, reemplaza solo el <svg> de este archivo
 * (mantén la prop `size` y el color con `currentColor`).
 */
interface Props {
  size?: number;
  class?: string;
}

const { size = 36, class: className } = Astro.props;
// Trazo más fino en tamaños grandes, como en la tarjeta del hero.
const stroke = size >= 48 ? 1.6 : 2;
---

<svg
  class:list={['logo', className]}
  width={size}
  height={size}
  viewBox="0 0 40 40"
  fill="none"
  stroke="currentColor"
  aria-hidden="true"
  focusable="false"
>
  <polygon points="20,2 36,11 36,29 20,38 4,29 4,11" stroke-width={stroke}></polygon>
  <polyline points="14,27 14,13 26,27 26,13" stroke-width={stroke * 1.2} stroke-linejoin="round"></polyline>
</svg>

<style>
  .logo {
    color: var(--gold);
    flex: none;
  }
</style>
