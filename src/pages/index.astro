---
import Base from '../layouts/Base.astro';
import Nav from '../components/sections/Nav.astro';
import Hero from '../components/sections/Hero.astro';
import Servicios from '../components/sections/Servicios.astro';
import Proyectos from '../components/sections/Proyectos.astro';
import Proceso from '../components/sections/Proceso.astro';
import Producto from '../components/sections/Producto.astro';
import Cotizar from '../components/sections/Cotizar.astro';
import Nosotros from '../components/sections/Nosotros.astro';
import Footer from '../components/sections/Footer.astro';
import {
  getCotizador,
  getHero,
  getNosotros,
  getProceso,
  getProducto,
  getProyectos,
  getServicios,
  getSite,
} from '../lib/content';
import { professionalServiceJsonLd, serializeJsonLd } from '../lib/seo';

const [site, hero, servicios, proyectos, proceso, producto, cotizador, nosotros] = await Promise.all([
  getSite(),
  getHero(),
  getServicios(),
  getProyectos(),
  getProceso(),
  getProducto(),
  getCotizador(),
  getNosotros(),
]);

const jsonLd = serializeJsonLd(professionalServiceJsonLd(site, new URL('/', Astro.site)));
---

<Base
  title={site.seo.titulo}
  description={site.seo.descripcion}
  siteName={site.nombre}
  image={site.seo.imagenOg}
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={jsonLd}
  />
  <Nav site={site} />
  <main id="contenido">
    <Hero hero={hero} />
    <Servicios servicios={servicios} />
    <Proyectos proyectos={proyectos} />
    <Proceso proceso={proceso} />
    <Producto producto={producto} />
    <Cotizar cotizador={cotizador} site={site} />
    <Nosotros nosotros={nosotros} />
  </main>
  <Footer site={site} />
</Base>
